# ============================================================
# App
# ============================================================
APP_ENV=development
APP_DATA_DIR=./data

# ============================================================
# Credential store backend
# One of: env, local_file
# (windows_credential_manager / macos_keychain are reserved for the
# future Tauri app and are not selectable here yet)
# ============================================================
CREDENTIAL_STORE_BACKEND=env

# Only used when CREDENTIAL_STORE_BACKEND=local_file.
# Fernet key used to encrypt the local dev credential file.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOCAL_CREDENTIAL_STORE_KEY=

# ============================================================
# Per-source PATs when CREDENTIAL_STORE_BACKEND=env
# Naming convention: MCP_PAT_<credential_ref>
# credential_ref is set per data source (see app/sources/models.py)
# Example:
# MCP_PAT_snowflake-prod=xxxxx
# ============================================================

# ============================================================
# Default user (local single-user desktop app, Phase 1)
# ============================================================
DEFAULT_USER_ID=local-user
DEFAULT_USER_DISPLAY_NAME=Mike
DEFAULT_USER_TIMEZONE=Asia/Kolkata
DEFAULT_USER_LANGUAGE=en

# ============================================================
# Groq (used starting Phase 2)
# ============================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# Conversation memory / summarization (used starting Phase 3)
# ============================================================
SUMMARY_TRIGGER_TOKENS=6000
RECENT_MESSAGES_KEEP=10

# ============================================================
# SQL safety layer (used starting Phase 7)
# ============================================================
SQL_SAFETY_MODE=strict
